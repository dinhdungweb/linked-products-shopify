{%- comment -%}
  Snippet: linked-product-option
  Renders an option based on style (swatch, variant_image, block)
  
  Parameters:
  - product_obj: product object
  - value: option value to display
  - selected: boolean
  - style: 'swatch', 'variant_image', 'block'
{%- endcomment -%}

{%- assign gradient_direction = 'to bottom right' -%}
{%- if two_color_style == 'L_R' -%}
  {%- assign gradient_direction = 'to right' -%}
{%- elsif two_color_style == 'LT_RB' -%}
  {%- assign gradient_direction = 'to bottom right' -%}
{%- elsif two_color_style == 'T_B' -%}
  {%- assign gradient_direction = 'to bottom' -%}
{%- elsif two_color_style == 'LB_RT' -%}
  {%- assign gradient_direction = 'to top right' -%}
{%- endif -%}

{%- assign url = product_obj.url -%}
{%- assign image = custom_image | default: product_obj.featured_image -%}
{%- assign is_unavailable = false -%}
{%- if product_obj.available == false -%}
  {%- assign is_unavailable = true -%}
{%- endif -%}

{%- assign final_image_url = "" -%}
{%- if custom_image != blank -%}
  {%- assign final_image_url = custom_image -%}
{%- elsif product_obj.featured_image != blank -%}
  {%- assign final_image_url = product_obj.featured_image | image_url: width: 150 -%}
{%- endif -%}

{%- comment -%}Color mapping - Ưu tiên custom_color, sau đó mới đến mapping tên màu{%- endcomment -%}
{%- assign has_color = false -%}
{%- assign css_color = "" -%}

{%- if custom_color != blank -%}
  {%- assign has_color = true -%}
  {%- assign css_color = custom_color -%}
{%- else -%}
  {%- assign color_value = value | downcase | strip -%}
  {%- case color_value -%}
    {%- when 'red' -%}
      {%- assign has_color = true -%}
      {%- assign css_color = "#dc2626" -%}
    {%- when 'blue' -%}
      {%- assign has_color = true -%}
      {%- assign css_color = "#2563eb" -%}
    {%- when 'green' -%}
      {%- assign has_color = true -%}
      {%- assign css_color = "#16a34a" -%}
    {%- when 'yellow' -%}
      {%- assign has_color = true -%}
      {%- assign css_color = "#eab308" -%}
    {%- when 'orange' -%}
      {%- assign has_color = true -%}
      {%- assign css_color = "#ea580c" -%}
    {%- when 'purple' -%}
      {%- assign has_color = true -%}
      {%- assign css_color = "#9333ea" -%}
    {%- when 'pink' -%}
      {%- assign has_color = true -%}
      {%- assign css_color = "#ec4899" -%}
    {%- when 'black' -%}
      {%- assign has_color = true -%}
      {%- assign css_color = "#171717" -%}
    {%- when 'white' -%}
      {%- assign has_color = true -%}
      {%- assign css_color = "#ffffff" -%}
    {%- when 'gray', 'grey' -%}
      {%- assign has_color = true -%}
      {%- assign css_color = "#6b7280" -%}
    {%- when 'brown' -%}
      {%- assign has_color = true -%}
      {%- assign css_color = "#92400e" -%}
    {%- when 'beige' -%}
      {%- assign has_color = true -%}
      {%- assign css_color = "#d4b896" -%}
    {%- when 'navy' -%}
      {%- assign has_color = true -%}
      {%- assign css_color = "#1e3a5f" -%}
    {%- when 'teal' -%}
      {%- assign has_color = true -%}
      {%- assign css_color = "#0d9488" -%}
    {%- when 'cyan' -%}
      {%- assign has_color = true -%}
      {%- assign css_color = "#06b6d4" -%}
    {%- when 'gold' -%}
      {%- assign has_color = true -%}
      {%- assign css_color = "#d4af37" -%}
    {%- when 'silver' -%}
      {%- assign has_color = true -%}
      {%- assign css_color = "#c0c0c0" -%}
    {%- when 'cream' -%}
      {%- assign has_color = true -%}
      {%- assign css_color = "#fffdd0" -%}
    {%- when 'coral' -%}
      {%- assign has_color = true -%}
      {%- assign css_color = "#ff7f50" -%}
    {%- when 'olive' -%}
      {%- assign has_color = true -%}
      {%- assign css_color = "#808000" -%}
    {%- when 'maroon' -%}
      {%- assign has_color = true -%}
      {%- assign css_color = "#800000" -%}
    {%- when 'mint' -%}
      {%- assign has_color = true -%}
      {%- assign css_color = "#98fb98" -%}
    {%- when 'lavender' -%}
      {%- assign has_color = true -%}
      {%- assign css_color = "#e6e6fa" -%}
    {%- when 'rose' -%}
      {%- assign has_color = true -%}
      {%- assign css_color = "#ff007f" -%}
    {%- when 'khaki' -%}
      {%- assign has_color = true -%}
      {%- assign css_color = "#c3b091" -%}
  {%- endcase -%}
  {%- if css_color == "" -%}
    {%- assign has_color = true -%}
    {%- assign css_color = "#FFFFFF" -%}
  {%- endif -%}
{%- endif -%}

{%- case style -%}

  {%- when 'image_swatch' -%}
    <span class="lp-outer-swatch {% if selected %}is-selected{% endif %} {% if is_unavailable %}is-unavailable{% endif %}">
      <a href="{{ url }}" 
         class="linked-option linked-option--image {% if selected %}is-selected{% endif %} {% if is_unavailable %}is-unavailable{% endif %}"
         title="{{ value }}{% if is_unavailable %} (Sold out){% endif %}">
        {%- if settings.badge.show -%}
          <span class="lp-badge lp-badge--{{ settings.badge.position | default: 'top-right' }}">{{ settings.badge.text }}</span>
        {%- endif -%}
        {%- if final_image_url != blank -%}
          <img src="{{ final_image_url }}" alt="{{ value }}" width="80" height="80" loading="lazy">
        {%- else -%}
          <span class="no-image">{{ value | slice: 0, 2 }}</span>
        {%- endif -%}
      </a>
    </span>

  {%- when 'slide_swatch' -%}
    <span class="lp-outer-swatch {% if selected %}is-selected{% endif %} {% if is_unavailable %}is-unavailable{% endif %}" style="display: block; width: var(--lp-swatch-size);">
      <a href="{{ url }}" 
         class="linked-option linked-option--slide {% if selected %}is-selected{% endif %} {% if is_unavailable %}is-unavailable{% endif %}"
         title="{{ value }}">
        {%- if settings.badge.show -%}
          <span class="lp-badge lp-badge--{{ settings.badge.position | default: 'top-right' }}">{{ settings.badge.text }}</span>
        {%- endif -%}
        <div class="slide-media">
          {%- if final_image_url != blank -%}
            <img src="{{ final_image_url }}" alt="{{ value }}" loading="lazy">
          {%- endif -%}
        </div>
        <div class="slide-info">
          {%- if settings.variantName.show != false -%}
            <span class="slide-title">{{ value }}</span>
          {%- endif -%}
          {%- if settings.price.show -%}
            <span class="slide-price">{{ product_obj.price | money }}</span>
          {%- endif -%}
        </div>
      </a>
    </span>

  {%- when 'polaroid_swatch' -%}
    <span class="lp-outer-swatch {% if selected %}is-selected{% endif %} {% if is_unavailable %}is-unavailable{% endif %}" style="width: var(--lp-swatch-size);">
      <a href="{{ url }}" 
         class="linked-option linked-option--polaroid {% if selected %}is-selected{% endif %} {% if is_unavailable %}is-unavailable{% endif %}"
         title="{{ value }}">
        {%- if settings.badge.show -%}
          <span class="lp-badge lp-badge--{{ settings.badge.position | default: 'top-right' }}">{{ settings.badge.text }}</span>
        {%- endif -%}
        <div class="polaroid-inner">
          {%- if final_image_url != blank -%}
            <img src="{{ final_image_url }}" alt="{{ value }}" loading="lazy">
          {%- endif -%}
        </div>
      </a>
    </span>

  {%- when 'color_swatch', 'square_color_swatch' -%}
    <span class="lp-outer-swatch {% if selected %}is-selected{% endif %} {% if is_unavailable %}is-unavailable{% endif %}" style="width: var(--lp-swatch-size); height: var(--lp-swatch-size);">
      <a href="{{ url }}" 
         class="linked-option linked-option--swatch {% if style == 'square_color_swatch' %}is-square{% endif %} {% if selected %}is-selected{% endif %} {% if is_unavailable %}is-unavailable{% endif %}"
         title="{{ value }}">
        {%- if has_color -%}
          <span class="swatch-bg swatch-bg--color" style="{% if item_style == 'two' %}background: linear-gradient({{ gradient_direction }}, {{ custom_color | default: '#ccc' }} 50%, {{ custom_color2 | default: '#ddd' }} 50%);{% else %}background-color: {{ css_color }};{% endif %}"></span>
        {%- elsif final_image_url != blank -%}
          <span class="swatch-bg" style="background-image: url({{ final_image_url }});"></span>
        {%- else -%}
          <span class="swatch-bg swatch-bg--text">{{ value | slice: 0 }}</span>
        {%- endif -%}

        {%- if selected -%}
          <span class="swatch-check">
            <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" style="width: 14px; height: 14px;"><path d="M15.8333 5L7.5 13.3333L4.16667 10" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        {%- endif -%}
      </a>
    </span>

  {%- when 'pill_swatch' -%}
    <span class="lp-outer-swatch {% if selected %}is-selected{% endif %} {% if is_unavailable %}is-unavailable{% endif %}" style="border-radius: var(--lp-border-radius);">
      <a href="{{ url }}" 
         class="linked-option linked-option--pill-swatch {% if selected %}is-selected{% endif %} {% if is_unavailable %}is-unavailable{% endif %}"
         title="{{ value }}">
        {%- if has_color -%}
          <span class="pill-dot" style="{% if item_style == 'two' %}background: linear-gradient({{ gradient_direction }}, {{ custom_color | default: '#ccc' }} 50%, {{ custom_color2 | default: '#ddd' }} 50%);{% else %}background-color: {{ css_color }};{% endif %}"></span>
        {%- endif -%}
        {%- if settings.variantName.show != false -%}
          <span class="pill-label">{{ value }}</span>
        {%- endif -%}
      </a>
    </span>

  {%- when 'button', 'pill_button', 'button_card' -%}
    <a href="{{ url }}" 
       class="linked-option linked-option--button {% if style == 'pill_button' or style == 'button_card' %}is-pill{% endif %} {% if selected %}is-selected{% endif %} {% if is_unavailable %}is-unavailable{% endif %}"
       title="{{ value }}">
      {{ value }}
    </a>

  {%- when 'image_swatch_card' -%}
    <span class="lp-outer-swatch {% if selected %}is-selected{% endif %} {% if is_unavailable %}is-unavailable{% endif %}" style="display: block; width: var(--lp-swatch-size);">
      <a href="{{ url }}" 
         class="linked-option linked-option--card {% if selected %}is-selected{% endif %} {% if is_unavailable %}is-unavailable{% endif %}"
         title="{{ value }}">
        {%- if settings.badge.show -%}
          <span class="lp-badge lp-badge--{{ settings.badge.position | default: 'top-right' }}">{{ settings.badge.text }}</span>
        {%- endif -%}
        <div class="card-media">
          {%- if final_image_url != blank -%}
            <img src="{{ final_image_url }}" alt="{{ value }}" loading="lazy">
          {%- else -%}
            <span class="no-image">{{ value | slice: 0, 1 }}</span>
          {%- endif -%}
        </div>
        {%- if settings.variantName.show != false -%}
          <span class="card-label">{{ value }}</span>
        {%- endif -%}
        {%- if settings.price.show -%}
          <span class="slide-price" style="font-size: var(--lp-price-font-size, 10px);">{{ product_obj.price | money }}</span>
        {%- endif -%}
      </a>
    </span>

  {%- when 'color_swatch_card' -%}
    <span class="lp-outer-swatch {% if selected %}is-selected{% endif %} {% if is_unavailable %}is-unavailable{% endif %}" style="display: block; width: var(--lp-swatch-size);">
      <a href="{{ url }}" 
         class="linked-option linked-option--card {% if selected %}is-selected{% endif %} {% if is_unavailable %}is-unavailable{% endif %}"
         title="{{ value }}">
        <div class="card-media is-color" 
             style="{% if item_style == 'two' %}background: linear-gradient({{ gradient_direction }}, {{ custom_color | default: '#ccc' }} 50%, {{ custom_color2 | default: '#ddd' }} 50%);{% elsif has_color %}background-color: {{ css_color }};{% elsif final_image_url != blank %}background-image: url({{ final_image_url }}); background-size: cover;{% else %}background-color: #f4f4f4;{% endif %}">
          {%- if has_color or final_image_url != blank -%}
            <span class="swatch-anchor"></span>
          {%- else -%}
            <span style="font-size: 10px; color: #999;">{{ value | slice: 0, 1 }}</span>
          {%- endif -%}

          {%- if selected -%}
            <span class="swatch-check">
                <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" style="width: 14px; height: 14px;"><path d="M15.8333 5L7.5 13.3333L4.16667 10" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          {%- endif -%}
        </div>
        {%- if settings.variantName.show != false -%}
          <span class="card-label">{{ value }}</span>
        {%- endif -%}
      </a>
    </span>

  {%- when 'dropdown', 'image_dropdown', 'dropdown_card' -%}
    <span class="dropdown-option-placeholder">Use block settings for dropdown</span>

  {%- else -%}
    <span class="lp-outer-swatch {% if selected %}is-selected{% endif %} {% if is_unavailable %}is-unavailable{% endif %}">
      <a href="{{ url }}" 
         class="linked-option linked-option--block {% if selected %}is-selected{% endif %} {% if is_unavailable %}is-unavailable{% endif %}"
         title="{% if is_unavailable %}{{ value }} (Sold out){% else %}{{ value }}{% endif %}">
          <span class="color-dot" style="{% if item_style == 'two' %}background: linear-gradient({{ gradient_direction }}, {{ custom_color | default: '#ccc' }} 50%, {{ custom_color2 | default: '#ddd' }} 50%);{% else %}background-color: {{ css_color }};{% endif %}"></span>
        {{ value }}
      </a>
    </span>

{%- endcase -%}
