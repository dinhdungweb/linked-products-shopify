{%- comment -%}
  Snippet: linked-product-card-swatches
  Renders swatches for a product card based on Admin Customizations.
  Usage:
  {% render 'linked-product-card-swatches', product: product %}
{%- endcomment -%}

{%- assign linked_handles_raw = product.metafields.linked_products.linked_list.value -%}
{%- assign group_status = product.metafields.linked_products.status.value | default: 'active' -%}
{%- assign raw_card_selector_style = product.metafields.linked_products.card_selector_style.value -%}
{%- assign active_handles = shop.metafields.linked_products.active_handles.value -%}
{%- assign registry_allows_product = true -%}
{%- if active_handles != blank -%}
  {%- assign registry_allows_product = false -%}
  {%- if active_handles contains product.handle -%}
    {%- assign registry_allows_product = true -%}
  {%- endif -%}
{%- endif -%}

{%- if registry_allows_product and linked_handles_raw != blank and linked_handles_raw.size > 1 and group_status == 'active' and raw_card_selector_style != 'hidden' -%}
  {%- assign current_handle = product.handle -%}
  {%- assign inventory_behavior = product.metafields.linked_products.inventory_behavior.value | default: 'show' -%}
  {%- assign app_settings = shop.metafields.linked_products.app_settings.value -%}
  {%- if app_settings == blank -%}
    {%- assign app_settings = shop.metafields.linked_products.settings.value -%}
  {%- endif -%}
  {%- assign style_customizations = shop.metafields.linked_products.style_customizations.value -%}
  {%- assign lp_sold_out_label = app_settings.soldOutLabel | default: 'Sold out' -%}
  {%- assign lp_unavailable_label = app_settings.unavailableLabel | default: 'Unavailable' -%}

  {%- comment -%}1. Resolve Card Style Key{%- endcomment -%}
  {%- assign default_card_style = app_settings.defaultProductCardStyle | default: app_settings.defaultCardStyle | default: 'image_swatch_card' -%}
  {%- assign card_style = raw_card_selector_style | default: default_card_style -%}
  
  {%- comment -%}Auto-migrate style mapping for robust retrieval{%- endcomment -%}
  {%- if card_style == "swatch" or card_style == 'image_swatch_on_card' or card_style == 'image_swatch' or card_style == 'slide_swatch' or card_style == 'scroll_swatch' or card_style == 'polaroid_swatch' -%}
    {%- assign card_style = "image_swatch_card" -%}
  {%- elsif card_style == "pill" or card_style == 'button_on_card' or card_style == 'button' or card_style == 'pill_button' or card_style == 'block' -%}
    {%- assign card_style = "button_card" -%}
  {%- elsif card_style == 'color_swatch_on_card' or card_style == 'color_swatch' or card_style == 'square_color_swatch' or card_style == 'pill_swatch' -%}
    {%- assign card_style = "color_swatch_card" -%}
  {%- elsif card_style == 'dropdown_on_card' or card_style == 'dropdown' or card_style == 'image_dropdown' -%}
    {%- assign card_style = "dropdown_card" -%}
  {%- elsif card_style == "same" -%}
    {%- assign page_style = product.metafields.linked_products.selector_style.value | default: 'image_swatch' -%}
    {%- if page_style == 'color_swatch' or page_style == 'square_color_swatch' or page_style == 'pill_swatch' or page_style == 'color_swatch_card' -%}
      {%- assign card_style = "color_swatch_card" -%}
    {%- elsif page_style == 'button' or page_style == 'pill_button' or page_style == 'block' or page_style == 'button_card' -%}
      {%- assign card_style = "button_card" -%}
    {%- elsif page_style == 'dropdown' or page_style == 'image_dropdown' or page_style == 'dropdown_card' -%}
      {%- assign card_style = "dropdown_card" -%}
    {%- else -%}
      {%- assign card_style = "image_swatch_card" -%}
    {%- endif -%}
  {%- endif -%}

  {%- comment -%}Try fetching active style settings, with fallback to 'swatch' if card_style is already migrated but data is only under old key{%- endcomment -%}
  {%- assign active_style_settings = style_customizations[card_style] -%}
  {%- if active_style_settings == nil and card_style == 'image_swatch_card' -%}
    {%- assign active_style_settings = style_customizations['swatch'] -%}
  {%- endif -%}

  {%- comment -%}2. Setup Dynamic Settings (No Hardcoding!){%- endcomment -%}
  {%- assign def_radius = 4 -%}
  {%- if card_style contains 'swatch' -%}{%- assign def_radius = 12 -%}{%- endif -%}
  
  {%- comment -%}Safely handle '0' and 'false' for default overrides{%- endcomment -%}
  {%- assign lp_border_radius = active_style_settings.border.radius -%}
  {%- if lp_border_radius == nil -%}
    {%- assign lp_border_radius = def_radius -%}
  {%- endif -%}

  {%- comment -%}MIGRATION GUARD: Auto-upgrade legacy '20' values to '50' for circle swatches{%- endcomment -%}
  {%- if lp_border_radius > 4 and lp_border_radius < 50 and card_style contains 'swatch' -%}
    {%- assign lp_border_radius = 50 -%}
  {%- endif -%}

  {%- assign lp_swatch_size = active_style_settings.basic.swatchSize -%}
  {%- if lp_swatch_size == nil -%}
    {%- assign lp_swatch_size = 26 -%}
  {%- endif -%}

  {%- assign lp_items_gap = active_style_settings.basic.gap -%}
  {%- if lp_items_gap == nil -%}
    {%- assign lp_items_gap = 8 -%}
  {%- endif -%}

  {%- assign lp_limit = active_style_settings.basic.limitDesktop | plus: 0 -%}
  {%- if lp_limit == 0 -%}
    {%- assign lp_limit = 5 -%}
  {%- endif -%}

  {%- assign lp_align = active_style_settings.layout.align -%}
  {%- if lp_align == nil -%}{%- assign lp_align = app_settings.cardAlign | default: 'left' -%}{%- endif -%}
  
  {%- assign show_label = app_settings.cardShowLabel -%}
  {%- if show_label == nil -%}
    {%- assign show_label = active_style_settings.label.show | default: false -%}
  {%- endif -%}

  {%- assign two_color_style_val = active_style_settings.basic.twoColorStyle | default: 'LT_RB' -%}
  {%- assign unavailable_style = active_style_settings.unavailable.style | default: active_style_settings.basic.unavailableStyle | default: 'cross_mark' -%}
  {%- assign card_display_mode = app_settings.cardDisplayMode | default: 'swatches' -%}
  {%- assign lp_available_count = 0 -%}
  {%- for item in linked_handles_raw -%}
    {%- assign item_handle = item.handle -%}
    {%- if item_handle == current_handle -%}
      {%- assign linked_prod_for_count = product -%}
    {%- else -%}
      {%- assign linked_prod_for_count = all_products[item_handle] -%}
    {%- endif -%}
    {%- if linked_prod_for_count != blank and linked_prod_for_count != empty -%}
      {%- if inventory_behavior == 'hide' and linked_prod_for_count.available == false -%}{%- continue -%}{%- endif -%}
      {%- if unavailable_style == 'hide' and linked_prod_for_count.available == false -%}{%- continue -%}{%- endif -%}
      {%- assign lp_available_count = lp_available_count | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}

  {%- comment -%}3. Render Single Container Flow{%- endcomment -%}
  <style>
    /* Scoped CSS for maximum specificity override */
    #lp-card-{{ product.id }} .card-media {
        border-radius: {{ lp_border_radius }}{% if card_style contains 'swatch' %}%{% else %}px{% endif %} !important;
        overflow: hidden !important;
    }
    #lp-card-{{ product.id }}.linked-product-swatches {
        position: relative !important;
        z-index: 25 !important;
        margin-top: {{ app_settings.cardMarginTop | default: 0 }}px !important;
        margin-bottom: {{ app_settings.cardMarginBottom | default: 6 }}px !important;
    } 
  </style>

  <div id="lp-card-{{ product.id }}" class="linked-product-swatches linked-products-picker" data-lp-handle="{{ product.handle }}" 
       style="
         --lp-border-radius: {{ lp_border_radius }}px;
         --lp-swatch-size: {{ lp_swatch_size }}px;
         --lp-swatch-gap: {{ lp_items_gap }}px;
         --lp-aspect-ratio: {{ active_style_settings.basic.aspectRatio | default: '1:1' | replace: ':', '/' }};
         --lp-justify: {%- if lp_align == 'center' -%}center{%- elsif lp_align == 'right' -%}flex-end{%- else -%}flex-start{%- endif -%};
         --lp-margin-top: {{ app_settings.cardMarginTop | default: 0 }}px;
         --lp-margin-bottom: {{ app_settings.cardMarginBottom | default: 6 }}px;
         --lp-border-width: {{ active_style_settings.border.width | default: 1 }}px;
         --lp-border-color: {{ active_style_settings.border.color | default: '#dbdfe2' }};
         --lp-selected-border-color: {{ active_style_settings.border.activeColor | default: '#000000' }};
         --lp-label-color: {{ active_style_settings.label.color | default: '#202020' }};
         --lp-label-size: {{ active_style_settings.label.fontSize | default: 13 }}px;
         --lp-btn-bg: {{ active_style_settings.basic.blockBg | default: '#FFFFFF' }};
         --lp-btn-bg-hover: {{ active_style_settings.basic.blockBgHover | default: '#f4f4f4' }};
         --lp-btn-bg-active: {{ active_style_settings.basic.blockBgActive | default: '#eee' }};
         --lp-btn-color: {{ active_style_settings.label.color | default: '#000' }};
         --lp-btn-color-hover: {{ active_style_settings.label.hoverColor | default: '#000' }};
         --lp-btn-color-active: {{ active_style_settings.label.activeColor | default: '#000' }};
         --lp-btn-border: {{ active_style_settings.border.color | default: '#dbdfe2' }};
         --lp-btn-border-hover: {{ active_style_settings.border.hoverColor | default: '#8c9196' }};
         --lp-btn-border-active: {{ active_style_settings.border.activeColor | default: '#000' }};
         --lp-unavailable-style: {{ unavailable_style }};
       "
       data-hover-effect="{{ active_style_settings.basic.hoverEffect | default: 'none' }}"
       data-unavailable-style="{{ unavailable_style }}">
    
    {%- if show_label -%}
        <div class="lp-card-label" style="text-align: {{ lp_align }}; color: var(--lp-label-color); font-size: var(--lp-label-size);">
            {{ active_style_settings.label.text | default: 'Options' }}:
        </div>
    {%- endif -%}

    {%- if card_display_mode == 'count' -%}
      <div class="lp-card-count" style="text-align: {{ lp_align }};">
        {{ lp_available_count }} {% if lp_available_count == 1 %}option{% else %}options{% endif %}
      </div>
    {%- else -%}
    <div class="variant-picker__option-values" 
         style="display: flex; flex-wrap: wrap; gap: var(--lp-swatch-gap); justify-content: var(--lp-justify); width: 100%;
                --lp-dd-padding: {{ active_style_settings.basic.padding | default: 8 }}px;
                --lp-dd-bg: {{ active_style_settings.basic.blockBg | default: '#FFFFFF' }};
                --lp-dd-color: {{ active_style_settings.label.color | default: '#202020' }};
                --lp-dd-border-color: {{ active_style_settings.border.color | default: '#e1e3e5' }};
                --lp-dd-border-width: {{ active_style_settings.border.width | default: 1 }}px;
         ">
        {%- if card_style == 'dropdown_card' -%}
            {%- comment -%}Dropdown Rendering Branch{%- endcomment -%}
            <select class="lp-card-dropdown" 
                    onchange="window.location.href = this.value;"
                    onclick="event.stopPropagation();"
                    onmousedown="event.stopPropagation();"
                    style="
                        width: 100%;
                        padding: var(--lp-dd-padding);
                        background-color: var(--lp-dd-bg);
                        color: var(--lp-dd-color);
                        border: var(--lp-dd-border-width) solid var(--lp-dd-border-color);
                        border-radius: var(--lp-border-radius);
                        font-size: 13px;
                        outline: none;
                        cursor: pointer;
                        pointer-events: auto;
                        position: relative;
                        z-index: 32;
                        appearance: none;
                        background-image: url('data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22292.4%22%20height%3D%22292.4%22%3E%3Cpath%20fill%3D%22%23666666%22%20d%3D%22M287%2069.4a17.6%2017.6%200%200%200-13-5.4H18.4c-5%200-9.3%201.8-12.9%205.4A17.6%2017.6%200%200%200%200%2082.2c0%205%201.8%209.3%205.4%2012.9l128%20127.9c3.6%203.6%207.8%205.4%2012.8%205.4s9.2-1.8%2012.8-5.4L287%2095c3.5-3.5%205.4-7.8%205.4-12.8%200-5-1.9-9.2-5.5-12.8z%22%2F%3E%3C%2Fsvg%3E');
                        background-repeat: no-repeat;
                        background-position: right 12px center;
                        background-size: 10px;
                    ">
                {%- for item in linked_handles_raw -%}
                    {%- assign item_handle = item.handle -%}
                    {%- assign linked_prod = all_products[item_handle] -%}
                    {%- if linked_prod != blank and linked_prod != empty -%}
                        {%- if inventory_behavior == 'hide' and linked_prod.available == false %}{% continue %}{% endif -%}
                        {%- if unavailable_style == 'hide' and linked_prod.available == false %}{% continue %}{% endif -%}
                        {%- assign value = item.title | default: linked_prod.title -%}
                        <option value="{{ linked_prod.url }}" {% if item_handle == current_handle %}selected{% endif %}>
                            {{ value }}{% if linked_prod.available == false %} ({{ lp_sold_out_label }}){% endif %}
                        </option>
                    {%- endif -%}
                {%- endfor -%}
            </select>
        {%- else -%}
            {%- comment -%}Swatches/Buttons Rendering Branch{%- endcomment -%}
            {%- assign rendered_count = 0 -%}
            {%- for item in linked_handles_raw -%}
                {%- if rendered_count >= lp_limit %}{% break %}{% endif -%}
                
                {%- assign item_handle = item.handle -%}
                {%- if item_handle == current_handle -%}
                    {%- if unavailable_style == 'hide' and product.available == false %}{% continue %}{% endif -%}
                    {%- assign current_value = product.metafields.linked_products.option_value.value | default: product.title -%}
                    {%- render 'linked-product-option', 
                        product_obj: product,
                        value: current_value, 
                        selected: true,
                        style: card_style,
                        settings: active_style_settings,
                        custom_image: item.image,
                        custom_color: item.color,
                        custom_color2: item.color2,
                        item_style: item.style,
                        two_color_style: two_color_style_val,
                        sold_out_label: lp_sold_out_label,
                        unavailable_label: lp_unavailable_label
                    -%}
                    {%- assign rendered_count = rendered_count | plus: 1 -%}
                {%- else -%}
                    {%- assign linked_prod = all_products[item_handle] -%}
                    {%- if linked_prod != blank and linked_prod != empty -%}
                        {%- if inventory_behavior == 'hide' and linked_prod.available == false %}{% continue %}{% endif -%}
                        {%- if unavailable_style == 'hide' and linked_prod.available == false %}{% continue %}{% endif -%}
                        {%- assign value = item.title | default: linked_prod.title -%}
                        {%- render 'linked-product-option', 
                            product_obj: linked_prod,
                            value: value, 
                            selected: false,
                            style: card_style,
                            settings: active_style_settings,
                            custom_image: item.image,
                            custom_color: item.color,
                            custom_color2: item.color2,
                            item_style: item.style,
                            two_color_style: two_color_style_val,
                            sold_out_label: lp_sold_out_label,
                            unavailable_label: lp_unavailable_label
                        -%}
                        {%- assign rendered_count = rendered_count | plus: 1 -%}
                    {%- endif -%}
                {%- endif -%}
            {%- endfor -%}

            {%- assign total_items = lp_available_count -%}
            {%- if total_items > rendered_count -%}
                {%- assign remaining = total_items | minus: rendered_count -%}
                <span class="lp-more-count">
                    +{{ remaining }}
                </span>
            {%- endif -%}
        {%- endif -%}
    </div>
    {%- endif -%}
  </div>
{%- endif -%}
