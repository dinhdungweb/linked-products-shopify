{%- comment -%}
  Linked Products Picker - Zero Latency Version
  This block reads linked products from Metafield and renders directly
{%- endcomment -%}

{%- assign linked_handles_raw = product.metafields.linked_products.linked_list.value -%}
{%- assign group_status = product.metafields.linked_products.status.value | default: 'active' -%}
{%- assign active_handles = shop.metafields.linked_products.active_handles.value -%}
{%- assign registry_allows_product = true -%}
{%- if active_handles != blank -%}
  {%- assign registry_allows_product = false -%}
  {%- if active_handles contains product.handle -%}
    {%- assign registry_allows_product = true -%}
  {%- endif -%}
{%- endif -%}

{%- if registry_allows_product and linked_handles_raw != blank and linked_handles_raw.size > 0 and group_status == 'active' -%}
  
  {%- assign inventory_behavior = product.metafields.linked_products.inventory_behavior.value | default: 'show' -%}
  {%- assign app_settings = shop.metafields.linked_products.settings.value -%}
  {%- assign style_customizations = shop.metafields.linked_products.style_customizations.value -%}
  {%- assign lp_sold_out_label = app_settings.soldOutLabel | default: 'Sold out' -%}
  {%- assign lp_unavailable_label = app_settings.unavailableLabel | default: 'Unavailable' -%}
  
  {%- if app_settings.appEnabled != false -%}
  
  {%- comment -%}Dynamic settings: prefer per-style customizations, fallback to hardcoded defaults (matches App BASE_SETTINGS){%- endcomment -%}
  {%- assign meta_selector_style = product.metafields.linked_products.selector_style.value -%}
  {%- assign meta_option_name = product.metafields.linked_products.option_name.value -%}
  {%- assign active_selector_style = meta_selector_style | default: 'block' -%}
  {%- assign active_option_name = meta_option_name| default: 'Color' -%}

  {%- comment -%}Normalize legacy/card IDs back to product-page style IDs{%- endcomment -%}
  {%- if active_selector_style == 'swatch' or active_selector_style == 'image_swatch_on_card' or active_selector_style == 'image_swatch_card' -%}
    {%- assign active_selector_style = 'image_swatch' -%}
  {%- elsif active_selector_style == 'color_swatch_on_card' or active_selector_style == 'color_swatch_card' -%}
    {%- assign active_selector_style = 'color_swatch' -%}
  {%- elsif active_selector_style == 'button_on_card' or active_selector_style == 'button_card' or active_selector_style == 'pill' -%}
    {%- assign active_selector_style = 'button' -%}
  {%- elsif active_selector_style == 'dropdown_on_card' or active_selector_style == 'dropdown_card' -%}
    {%- assign active_selector_style = 'dropdown' -%}
  {%- endif -%}

  {%- assign active_style_settings = style_customizations[active_selector_style] -%}
  
  {%- comment -%}Style-specific Defaults (Sync with DEFAULT_SETTINGS_BY_STYLE in app/utils/style-utils.jsx){%- endcomment -%}
  {%- assign def_size = 32 -%}
  {%- assign def_gap = 10 -%}
  {%- assign def_padding = 0 -%}
  {%- assign def_radius = 4 -%}
  {%- assign def_width = 1 -%}
  {%- assign def_outer_width = 0 -%}
  {%- assign def_outer_padding = 4 -%}
  {%- assign def_outer_radius = 4 -%}
  {%- assign def_shadow_show = false -%}
  {%- assign def_max_lines = 1 -%}

  {%- if active_selector_style == 'image_swatch' -%}
    {%- assign def_size = 48 -%}{%- assign def_radius = 100 -%}
  {%- elsif active_selector_style == 'scroll_swatch' or active_selector_style == 'slide_swatch' -%}{%- assign def_size = 90 -%}{%- assign def_radius = 0 -%}{%- assign def_padding = 5 -%}{%- assign def_max_lines = 2 -%}
  {%- elsif active_selector_style == 'polaroid_swatch' -%}
    {%- assign def_size = 52 -%}{%- assign def_padding = 4 -%}{%- assign def_radius = 0 -%}{%- assign def_shadow_show = true -%}
  {%- elsif active_selector_style == 'color_swatch' -%}
    {%- assign def_size = 32 -%}{%- assign def_radius = 20 -%}{%- assign def_width = 2 -%}{%- assign def_outer_width = 2 -%}{%- assign def_outer_padding = 2 -%}{%- assign def_outer_radius = 20 -%}
  {%- elsif active_selector_style == 'square_color_swatch' -%}
    {%- assign def_size = 32 -%}{%- assign def_radius = 4 -%}{%- assign def_width = 2 -%}{%- assign def_outer_width = 2 -%}{%- assign def_outer_padding = 2 -%}{%- assign def_outer_radius = 6 -%}
  {%- elsif active_selector_style == 'pill_swatch' -%}
    {%- assign def_padding = 6 -%}{%- assign def_radius = 20 -%}
  {%- elsif active_selector_style == 'button' -%}
    {%- assign def_padding = 8 -%}{%- assign def_radius = 0 -%}
  {%- elsif active_selector_style == 'pill_button' -%}
    {%- assign def_padding = 8 -%}{%- assign def_radius = 20 -%}
  {%- elsif active_selector_style == 'image_swatch_card' -%}
    {%- assign def_size = 40 -%}{%- assign def_padding = 8 -%}{%- assign def_max_lines = 2 -%}
  {%- elsif active_selector_style == 'color_swatch_card' -%}
    {%- assign def_size = 32 -%}{%- assign def_padding = 8 -%}{%- assign def_radius = 20 -%}{%- assign def_max_lines = 2 -%}
  {%- endif -%}

  {%- assign lp_swatch_size = active_style_settings.basic.swatchSize | default: def_size -%}
  {%- assign lp_items_gap = active_style_settings.basic.gap | default: def_gap -%}
  {%- assign lp_padding = active_style_settings.basic.padding | default: def_padding -%}
  {%- assign lp_two_color_style = active_style_settings.basic.twoColorStyle | default: 'LT_RB' -%}
  
  {%- assign lp_border_radius = active_style_settings.border.radius -%}
  {%- if lp_border_radius == blank -%}
    {%- assign lp_border_radius = def_radius -%}
  {%- endif -%}
  
  {%- assign lp_radius_unit = 'px' -%}

  {%- assign lp_border_width = active_style_settings.border.width | default: def_width -%}
  {%- assign lp_border_color = active_style_settings.border.color | default: '#dbdfe2' -%}
  {%- assign lp_selected_border_color = active_style_settings.border.activeColor | default: '#000000' -%}
  {%- assign lp_hover_border_color = active_style_settings.border.hoverColor | default: lp_border_color -%}

  {%- assign lp_outer_width = active_style_settings.border.outerWidth | default: def_outer_width -%}
  {%- assign lp_outer_padding = active_style_settings.border.outerPadding | default: def_outer_padding -%}
  {%- assign lp_outer_radius = active_style_settings.border.outerRadius -%}
  {%- if lp_outer_radius == blank -%}
    {%- assign lp_outer_radius = def_outer_radius -%}
  {%- endif -%}

  {%- assign lp_outer_radius_unit = 'px' -%}

  {%- assign lp_outer_color = active_style_settings.border.outerColor | default: '#dbdfe2' -%}
  {%- assign lp_outer_active_color = active_style_settings.border.outerActiveColor | default: '#000000' -%}
  {%- assign lp_outer_hover_color = active_style_settings.border.outerHoverColor | default: lp_outer_color -%}
  
  {%- assign lp_hide_active = active_style_settings.basic.hideActiveSwatch | default: false -%}
  {%- assign lp_active_first = active_style_settings.basic.activeSwatchFirst | default: false -%}
  {%- assign lp_max_swatches = active_style_settings.layout.maxSwatches | default: 100 -%}

  {%- assign lp_show_label = true -%}
  {%- if app_settings.showOptionName == false -%}
    {%- assign lp_show_label = false -%}
  {%- elsif active_style_settings.label.show == false -%}
    {%- assign lp_show_label = false -%}
  {%- endif -%}

  {%- assign lp_label_layout = active_style_settings.label.layout | default: 'inline' -%}
  {%- assign lp_label_gap = active_style_settings.label.gap | default: 8 -%}
  {%- assign lp_label_font_size = active_style_settings.label.fontSize | default: 14 -%}
  {%- assign lp_label_font_weight = active_style_settings.label.fontWeight | default: 'normal' -%}
  
  {%- assign lp_layout_margin_top = active_style_settings.layout.marginTop | default: 0 -%}
  {%- assign lp_layout_margin_bottom = active_style_settings.layout.marginBottom | default: 10 -%}
  {%- assign lp_layout_align = active_style_settings.layout.align | default: 'left' -%}
  {%- if lp_layout_align == 'left' -%}
    {%- assign lp_justify_content = 'flex-start' -%}
  {%- elsif lp_layout_align == 'center' -%}
    {%- assign lp_justify_content = 'center' -%}
  {%- elsif lp_layout_align == 'right' -%}
    {%- assign lp_justify_content = 'flex-end' -%}
  {%- endif -%}

  {%- assign lp_show_selected_variant = active_style_settings.label.showSelectedVariant | default: true -%}
  {%- assign raw_selected_weight = active_style_settings.label.selectedVariantFontWeight | default: 'normal' -%}
  {%- case raw_selected_weight -%}
    {%- when 'lighter' -%}{%- assign lp_selected_weight = 200 -%}
    {%- when 'normal' -%}{%- assign lp_selected_weight = 400 -%}
    {%- when 'semibold' -%}{%- assign lp_selected_weight = 600 -%}
    {%- when 'bold' -%}{%- assign lp_selected_weight = 700 -%}
    {%- when 'bolder' -%}{%- assign lp_selected_weight = 900 -%}
    {%- else -%}{%- assign lp_selected_weight = raw_selected_weight -%}
  {%- endcase -%}
  
  {%- assign lp_hover_effect = active_style_settings.basic.hoverEffect | default: 'none' -%}
  {%- assign lp_unavailable_style = active_style_settings.unavailable.style | default: active_style_settings.basic.unavailableStyle | default: 'cross_mark' -%}

  {%- assign lp_variant_font_size = active_style_settings.variantName.fontSize | default: 12 -%}
  {%- assign raw_variant_weight = active_style_settings.variantName.fontWeight | default: 'semibold' -%}
  {%- case raw_variant_weight -%}
    {%- when 'lighter' -%}{%- assign lp_variant_weight = 200 -%}
    {%- when 'normal' -%}{%- assign lp_variant_weight = 400 -%}
    {%- when 'semibold' -%}{%- assign lp_variant_weight = 600 -%}
    {%- when 'bold' -%}{%- assign lp_variant_weight = 700 -%}
    {%- when 'bolder' -%}{%- assign lp_variant_weight = 900 -%}
    {%- else -%}{%- assign lp_variant_weight = raw_variant_weight -%}
  {%- endcase -%}
  {%- assign lp_max_lines = active_style_settings.variantName.maxLines | default: def_max_lines -%}

  {%- assign lp_price_font_size = active_style_settings.price.fontSize | default: 10 -%}
  {%- assign raw_price_weight = active_style_settings.price.fontWeight | default: 'normal' -%}
  {%- case raw_price_weight -%}
    {%- when 'lighter' -%}{%- assign lp_price_weight = 200 -%}
    {%- when 'normal' -%}{%- assign lp_price_weight = 400 -%}
    {%- when 'semibold' -%}{%- assign lp_price_weight = 600 -%}
    {%- when 'bold' -%}{%- assign lp_price_weight = 700 -%}
    {%- when 'bolder' -%}{%- assign lp_price_weight = 900 -%}
    {%- else -%}{%- assign lp_price_weight = raw_price_weight -%}
  {%- endcase -%}
  {%- assign lp_price_color = active_style_settings.price.color | default: '#6d7175' -%}

  {%- assign lp_aspect_ratio = active_style_settings.basic.aspectRatio | replace: ':', '/' | default: '1/1' -%}
  {%- assign lp_image_position = active_style_settings.basic.imagePosition | default: 'center' -%}

  {%- assign lp_shadow_show = active_style_settings.shadow.show | default: def_shadow_show -%}
  {%- assign lp_shadow_color = active_style_settings.shadow.color | default: 'rgba(0,0,0,0.1)' -%}
  {%- assign lp_shadow_blur = active_style_settings.shadow.blur | default: 4 -%}
  {%- assign lp_shadow_spread = active_style_settings.shadow.spread | default: 0 -%}
  {%- assign lp_shadow_x = active_style_settings.shadow.offsetX | default: 0 -%}
  {%- assign lp_shadow_y = active_style_settings.shadow.offsetY | default: 2 -%}

  {%- assign lp_badge_size = active_style_settings.badge.fontSize | default: 10 -%}
  {%- assign lp_badge_color = active_style_settings.badge.color | default: '#ffffff' -%}
  {%- assign lp_badge_bg = active_style_settings.badge.bgColor | default: '#000000' -%}
  {%- assign lp_button_padding = active_style_settings.basic.padding | default: 8 -%}
  {%- assign lp_button_padding_x = lp_button_padding | times: 1.5 -%}
  {%- assign lp_block_bg = active_style_settings.basic.blockBg | default: '#ffffff' -%}
  {%- assign lp_selected_bg = active_style_settings.basic.blockBgActive | default: '#f4f6f8' -%}

  {%- assign lp_layout_type = active_style_settings.layout.type | default: 'stack' -%}
  {%- assign lp_is_scroll = false -%}
  {%- if lp_layout_type == 'scroll' or lp_layout_type == 'slide' -%}
    {%- assign lp_is_scroll = true -%}
  {%- elsif lp_layout_type == 'scroll_mobile' or lp_layout_type == 'slide_mobile' -%}
    {%- comment -%}For now, keep it simple or implement specific mobile check if needed{%- endcomment -%}
    {%- assign lp_is_scroll = true -%}
  {%- endif -%}

  {%- assign lp_visible_count = 0 -%}
  {%- for item in linked_handles_raw -%}
    {%- assign item_handle_for_count = item.handle -%}
    {%- if item_handle_for_count == product.handle -%}
      {%- if lp_hide_active -%}{%- continue -%}{%- endif -%}
      {%- if lp_unavailable_style == 'hide' and product.available == false -%}{%- continue -%}{%- endif -%}
      {%- assign lp_visible_count = lp_visible_count | plus: 1 -%}
    {%- else -%}
      {%- assign linked_prod_for_count = all_products[item_handle_for_count] -%}
      {%- if linked_prod_for_count != blank and linked_prod_for_count != empty -%}
        {%- if inventory_behavior == 'hide' and linked_prod_for_count.available == false -%}{%- continue -%}{%- endif -%}
        {%- if lp_unavailable_style == 'hide' and linked_prod_for_count.available == false -%}{%- continue -%}{%- endif -%}
        {%- assign lp_visible_count = lp_visible_count | plus: 1 -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}




  {{ 'linked-products.css' | asset_url | stylesheet_tag }}

  {%- if app_settings.customCssProduct != blank -%}
    <style id="lp-custom-css-v3">
      {{ app_settings.customCssProduct }}
    </style>
  {%- endif -%}

  <div class="linked-products-picker" style="
    --lp-swatch-size: {{ lp_swatch_size | replace: 'px', '' }}px;
    --lp-items-gap: {{ lp_items_gap }}px;
    --lp-swatch-padding: {{ lp_padding }}px;
    --lp-block-padding-y: {{ lp_button_padding }}px;
    --lp-block-padding-x: {{ lp_button_padding_x }}px;
    --lp-border-radius: {{ lp_border_radius }}{{ lp_radius_unit }};
    --lp-border-color: {{ lp_border_color }};
    --lp-selected-border-color: {{ lp_selected_border_color }};
    --lp-hover-border-color: {{ lp_hover_border_color }};
    --lp-border-width: {{ lp_border_width }}px;
    --lp-outer-width: {{ lp_outer_width }}px;
    --lp-outer-padding: {% if lp_outer_width > 0 %}{{ lp_outer_padding }}{% else %}0{% endif %}px;
    --lp-outer-radius: {{ lp_outer_radius }}{{ lp_outer_radius_unit | default: 'px' }};
    --lp-outer-color: {{ lp_outer_color }};
    --lp-outer-active-color: {{ lp_outer_active_color }};
    --lp-outer-hover-color: {{ lp_outer_hover_color }};
    --lp-margin-top: {{ lp_layout_margin_top }}px;
    --lp-margin-bottom: {{ lp_layout_margin_bottom }}px;
    --lp-justify: {{ lp_justify_content }};
    --lp-label-gap: {{ lp_label_gap }}px;
    --lp-label-size: {{ lp_label_font_size }}px;
    --lp-label-weight: {{ lp_label_font_weight }};
    --lp-variant-font-size: {{ lp_variant_font_size }}px;
    --lp-variant-weight: {{ lp_variant_weight }};
    --lp-max-lines: {{ lp_max_lines }};
    --lp-price-font-size: {{ lp_price_font_size }}px;
    --lp-price-weight: {{ lp_price_weight }};
    --lp-price-color: {{ lp_price_color }};
    --lp-aspect-ratio: {{ lp_aspect_ratio }};
    --lp-image-position: {{ lp_image_position }};
    --lp-hover-effect: {{ lp_hover_effect }};
    --lp-selected-weight: {{ lp_selected_weight }};
    --lp-show-selected: {% if lp_show_selected_variant %}block{% else %}none{% endif %};
    --lp-unavailable-style: {{ lp_unavailable_style }};
    --lp-block-bg: {{ lp_block_bg }};
    --lp-selected-bg: {{ lp_selected_bg }};
    --lp-neutral-bg: #f5f5f5;
    --lp-neutral-border: rgba(0,0,0,0.05);
    {% if lp_shadow_show %}
    --lp-shadow: {{ lp_shadow_x }}px {{ lp_shadow_y }}px {{ lp_shadow_blur }}px {{ lp_shadow_spread }}px {{ lp_shadow_color }};
    {% else %}
    --lp-shadow: none;
    {% endif %}
    --lp-badge-size: {{ lp_badge_size }}px;
    --lp-badge-color: {{ lp_badge_color }};
    --lp-badge-bg: {{ lp_badge_bg }};
  "
  data-hover-effect="{{ lp_hover_effect }}"
  data-unavailable-style="{{ lp_unavailable_style }}"
  >
    <div class="variant-picker">
      <fieldset class="variant-picker__option" style="text-align: {{ lp_layout_align }};">
        {%- if lp_show_label and active_option_name != blank -%}
          <div class="variant-picker__option-info" style="margin-bottom: {{ lp_label_gap }}px; justify-content: {{ lp_justify_content }};">
            <div class="h-stack" style="gap: 4px; flex-direction: {% if lp_label_layout == 'stack' %}column{% else %}row{% endif %}; align-items: {% if lp_layout_align == 'center' %}center{% elsif lp_layout_align == 'right' %}flex-end{% else %}flex-start{% endif %};">
              {%- assign select_label = active_option_name -%}
              {%- if app_settings.selectOptionLabel != blank -%}
                {%- assign select_label = app_settings.selectOptionLabel | replace: '{option}', active_option_name -%}
              {%- endif -%}
              <span class="text-subdued" style="font-size: {{ lp_label_font_size }}px; font-weight: {{ lp_label_font_weight }};">{{ select_label }}:</span>
              <span class="selected-value" style="font-size: {{ lp_label_font_size }}px;">{{ product.metafields.linked_products.option_value.value | default: product.title }}</span>
            </div>
          </div>
        {%- endif -%}

        {%- if active_selector_style contains 'dropdown' -%}
          <div class="variant-picker__dropdown-container" data-style="{{ active_selector_style }}">
              <div class="lp-dropdown">
                  <div class="lp-dropdown__selected" onclick="this.nextElementSibling.classList.toggle('show')">
                      {%- if active_selector_style == 'image_dropdown' -%}
                          <img src="{{ product.featured_image | image_url: width: 80 }}" 
                               alt="" 
                               class="lp-dropdown__img" 
                               loading="lazy"
                               width="80"
                               height="80">
                      {%- endif -%}
                      <span class="lp-dropdown__text">{{ product.metafields.linked_products.option_value.value | default: product.title }}</span>
                      <svg class="lp-dropdown__icon" width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      {%- if product.available == false -%}<span class="lp-unavailable-effect"></span>{%- endif -%}
                  </div>
                  <div class="lp-dropdown__options">
                    {%- for item in linked_handles_raw -%}
                      {%- assign item_handle = item.handle -%}
                      {%- if item_handle == product.handle %}{% continue %}{% endif -%}
                      {%- assign linked_prod = all_products[item_handle] -%}
                      {%- if linked_prod != blank and linked_prod != empty -%}
                        {%- if inventory_behavior == 'hide' and linked_prod.available == false %}{% continue %}{% endif -%}
                        {%- if lp_unavailable_style == 'hide' and linked_prod.available == false %}{% continue %}{% endif -%}
                        {%- assign value = item.title | default: linked_prod.title -%}
                        <a href="{{ linked_prod.url }}" class="lp-dropdown__item {% if linked_prod.available == false %}is-sold-out{% endif %}">
                            {%- if active_selector_style == 'image_dropdown' -%}
                                {%- if item.image != blank -%}
                                    <img src="{{ item.image }}" 
                                         alt="" 
                                         class="lp-dropdown__img" 
                                         loading="lazy"
                                         width="80"
                                         height="80">
                                {%- else -%}
                                    <img src="{{ linked_prod.featured_image | image_url: width: 80 }}" 
                                         alt="" 
                                         class="lp-dropdown__img" 
                                         loading="lazy"
                                         width="80"
                                         height="80">
                                {%- endif -%}
                            {%- endif -%}
                            <span class="lp-dropdown__text">{{ value }}</span>
                            {%- if linked_prod.available == false -%}
                                <span class="lp-dropdown__sold-out">({{ lp_sold_out_label }})</span>
                                <span class="lp-unavailable-effect"></span>
                            {%- endif -%}
                        </a>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
              </div>
          </div>
          <script>
              document.addEventListener('click', function(e) {
                  if (!e.target.closest('.lp-dropdown')) {
                      document.querySelectorAll('.lp-dropdown__options.show').forEach(el => el.classList.remove('show'));
                  }
              });
          </script>
        {%- else -%}
          <div class="variant-picker__option-values {% unless lp_is_scroll %}wrap{% endunless %} {% if lp_is_scroll %}is-scroll is-slide{% endif %} {% if lp_layout_type == 'scroll_mobile' or lp_layout_type == 'slide_mobile' %}is-scroll-mobile{% endif %}" style="gap: var(--lp-items-gap); justify-content: var(--lp-justify); min-width: 0; width: 100%;">
            {%- assign rendered_count = 0 -%}
            {%- assign current_handle_str = product.handle -%}
            
            {%- comment -%}1. Render Active First if enabled and not hidden{%- endcomment -%}
            {%- if lp_active_first and lp_hide_active == false -%}
                {%- for item in linked_handles_raw -%}
                    {%- if item.handle == current_handle_str -%}
                        {%- if lp_unavailable_style == 'hide' and product.available == false %}{% continue %}{% endif -%}
                        {%- assign current_value = product.metafields.linked_products.option_value.value | default: product.title -%}
                        {%- render 'linked-product-option', 
                            product_obj: product,
                            value: current_value, 
                            selected: true,
                            style: active_selector_style,
                            settings: active_style_settings,
                            custom_image: item.image,
                            custom_color: item.color,
                            custom_color2: item.color2,
                            item_style: item.style,
                            two_color_style: lp_two_color_style,
                            sold_out_label: lp_sold_out_label,
                            unavailable_label: lp_unavailable_label
                        -%}
                        {%- assign rendered_count = 1 -%}
                        {%- break -%}
                    {%- endif -%}
                {%- endfor -%}
            {%- endif -%}

            {%- comment -%}2. Main Loop for others{%- endcomment -%}
              {%- for item in linked_handles_raw -%}
              {%- if rendered_count >= lp_max_swatches -%}
                {%- assign remaining = lp_visible_count | minus: rendered_count -%}
                {%- if remaining > 0 -%}
                    <span class="lp-more-count">+{{ remaining }}</span>
                {%- endif -%}
                {%- break -%}
              {%- endif -%}
              
              {%- assign item_handle = item.handle -%}
              
              {%- if item_handle == current_handle_str -%}
                {%- if lp_active_first or lp_hide_active %}{% continue %}{% endif -%}
                {%- if lp_unavailable_style == 'hide' and product.available == false %}{% continue %}{% endif -%}
                
                {%- assign current_value = product.metafields.linked_products.option_value.value | default: product.title -%}
                {%- render 'linked-product-option', 
                    product_obj: product,
                    value: current_value, 
                    selected: true,
                    style: active_selector_style,
                    settings: active_style_settings,
                    custom_image: item.image,
                    custom_color: item.color,
                    custom_color2: item.color2,
                    item_style: item.style,
                    two_color_style: lp_two_color_style,
                    sold_out_label: lp_sold_out_label,
                    unavailable_label: lp_unavailable_label
                -%}
                {%- assign rendered_count = rendered_count | plus: 1 -%}
              {%- else -%}
                {%- assign linked_prod = all_products[item_handle] -%}
                {%- if linked_prod != blank and linked_prod != empty -%}
                  {%- if inventory_behavior == 'hide' and linked_prod.available == false -%}{%- continue -%}{%- endif -%}
                  {%- if lp_unavailable_style == 'hide' and linked_prod.available == false -%}{%- continue -%}{%- endif -%}

                  {%- assign value = item.title | default: linked_prod.title -%}
                  {%- render 'linked-product-option', 
                      product_obj: linked_prod,
                      value: value, 
                      selected: false,
                      style: active_selector_style,
                      settings: active_style_settings,
                      custom_image: item.image,
                      custom_color: item.color,
                      custom_color2: item.color2,
                      item_style: item.style,
                      two_color_style: lp_two_color_style,
                      sold_out_label: lp_sold_out_label,
                      unavailable_label: lp_unavailable_label
                  -%}
                  {%- assign rendered_count = rendered_count | plus: 1 -%}
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </fieldset>
    </div>
  </div>

{%- endif -%}
{%- endif -%}

