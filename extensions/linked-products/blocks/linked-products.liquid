{%- comment -%}
  Linked Products Picker - Zero Latency Version
  This block reads linked products from Metafield and renders directly
  
  Order logic:
  - Get all handles from linked_list metafield
  - Add current handle to create full list
  - Render in list order, mark selected for current product
{%- endcomment -%}

{%- assign linked_handles_raw = product.metafields.linked_products.linked_list.value -%}

{%- if linked_handles_raw != blank and linked_handles_raw.size > 0 -%}
  
  {%- comment -%}Create array with all handles (including current){%- endcomment -%}
  {%- assign current_handle = product.handle -%}
  {%- assign inventory_behavior = product.metafields.linked_products.inventory_behavior.value | default: 'show' -%}
  
  <div class="linked-products-picker{% unless block.settings.enable_hover_effect %} no-hover-effect{% endunless %}" style="
    --lp-swatch-size: {{ block.settings.swatch_size }}px;
    --lp-items-gap: {{ block.settings.items_gap }}px;
    --lp-border-radius: {{ block.settings.border_radius }}px;
    --lp-border-color: {{ block.settings.border_color }};
    --lp-selected-border-color: {{ block.settings.selected_border_color }};
    --lp-border-width: {{ block.settings.border_width }}px;
    --lp-block-padding-x: {{ block.settings.block_padding_x }}px;
    --lp-block-padding-y: {{ block.settings.block_padding_y }}px;
    --lp-block-font-size: {{ block.settings.block_font_size }}px;
    --lp-block-bg: {{ block.settings.block_bg_color }};
    --lp-block-text: {{ block.settings.block_text_color }};
    --lp-selected-bg: {{ block.settings.selected_bg_color }};
    --lp-selected-text: {{ block.settings.selected_text_color }};
  ">
    <div class="variant-picker">
      <fieldset class="variant-picker__option">
        {%- if block.settings.show_option_name and block.settings.option_name != blank -%}
          <div class="variant-picker__option-info">
            <div class="h-stack gap-2">
              <legend class="text-subdued">{{ block.settings.option_name | escape }}:</legend>
              <span class="selected-value">{{ product.metafields.linked_products.option_value.value | default: product.title }}</span>
            </div>
          </div>
        {%- endif -%}

        <div class="variant-picker__option-values wrap" style="gap: var(--lp-items-gap);">
          {%- assign current_rendered = false -%}
          
          {%- for item in linked_handles_raw -%}
            {%- assign item_handle = item.handle -%}
            {%- if item_handle == current_handle -%}
              {%- comment -%}Render current product with selected = true{%- endcomment -%}
              {%- assign current_value = product.metafields.linked_products.option_value.value | default: product.title -%}
              {%- render 'linked-product-option', 
                  product_obj: product,
                  value: current_value, 
                  selected: true,
                  style: block.settings.selector_style,
                  settings: block.settings,
                  custom_image: item.image,
                  custom_color: item.color
              -%}
              {%- assign current_rendered = true -%}
            {%- else -%}
              {%- comment -%}Render linked product{%- endcomment -%}
              {%- assign linked_prod = all_products[item_handle] -%}
              {%- if linked_prod != blank and linked_prod != empty -%}
                
                {%- comment -%}Inventory logic{%- endcomment -%}
                {%- if inventory_behavior == 'hide' and linked_prod.available == false -%}
                  {%- continue -%}
                {%- endif -%}

                {%- assign value = item.title | default: linked_prod.title -%}
                {%- render 'linked-product-option', 
                    product_obj: linked_prod,
                    value: value, 
                    selected: false,
                    style: block.settings.selector_style,
                    settings: block.settings,
                    custom_image: item.image,
                    custom_color: item.color
                -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          
          {%- comment -%}If current product not rendered (not in list), render at end{%- endcomment -%}
          {%- unless current_rendered -%}
            {%- assign current_value = product.metafields.linked_products.option_value.value | default: product.title -%}
            {%- render 'linked-product-option', 
                product_obj: product,
                value: current_value, 
                selected: true,
                style: block.settings.selector_style,
                settings: block.settings
            -%}
          {%- endunless -%}
        </div>
      </fieldset>
    </div>
  </div>

{%- endif -%}

{% schema %}
{
  "name": "Linked Products",
  "target": "section",
  "stylesheet": "linked-products.css",
  "settings": [
    {
      "type": "header",
      "content": "General"
    },
    {
      "type": "text",
      "id": "option_name",
      "label": "Option Name",
      "default": "Color",
      "info": "Display name for the option (e.g. Color, Size, Material)"
    },
    {
      "type": "checkbox",
      "id": "show_option_name",
      "label": "Show option name",
      "default": true
    },
    {
      "type": "select",
      "id": "selector_style",
      "label": "Selector Style",
      "options": [
        { "value": "swatch", "label": "Color Swatch" },
        { "value": "variant_image", "label": "Product Image" },
        { "value": "block", "label": "Text Block" }
      ],
      "default": "block"
    },
    {
      "type": "checkbox",
      "id": "enable_hover_effect",
      "label": "Enable hover effect",
      "default": true,
      "info": "Show lift and shadow effect on hover"
    },
    {
      "type": "header",
      "content": "Size & Spacing"
    },
    {
      "type": "range",
      "id": "swatch_size",
      "label": "Swatch/Image size",
      "min": 30,
      "max": 80,
      "step": 5,
      "default": 50,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "items_gap",
      "label": "Gap between items",
      "min": 4,
      "max": 20,
      "step": 2,
      "default": 8,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "default": 8,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "selected_border_color",
      "label": "Selected border color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Default border color",
      "default": "#e5e5e5"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Text Block Style"
    },
    {
      "type": "range",
      "id": "block_padding_x",
      "label": "Horizontal padding",
      "min": 8,
      "max": 24,
      "step": 2,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "block_padding_y",
      "label": "Vertical padding",
      "min": 4,
      "max": 16,
      "step": 2,
      "default": 8,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "block_font_size",
      "label": "Font size",
      "min": 12,
      "max": 20,
      "step": 1,
      "default": 14,
      "unit": "px",
      "info": "Set to 0 to use theme default"
    },
    {
      "type": "color",
      "id": "block_bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "block_text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "selected_bg_color",
      "label": "Selected background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "selected_text_color",
      "label": "Selected text color",
      "default": "#ffffff"
    }
  ]
}
{% endschema %}
