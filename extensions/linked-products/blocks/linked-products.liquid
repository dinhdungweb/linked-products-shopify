{%- comment -%}
  Linked Products Picker - Zero Latency Version
  This block reads linked products from Metafield and renders directly
{%- endcomment -%}

{%- assign linked_handles_raw = product.metafields.linked_products.linked_list.value -%}

{%- if linked_handles_raw != blank and linked_handles_raw.size > 0 -%}
  
  {%- assign current_handle = product.handle -%}
  {%- assign inventory_behavior = product.metafields.linked_products.inventory_behavior.value | default: 'show' -%}
  {%- assign app_settings = shop.metafields.linked_products.settings.value -%}
  
  {%- assign meta_selector_style = product.metafields.linked_products.selector_style.value -%}
  {%- assign meta_option_name = product.metafields.linked_products.option_name.value -%}
  {%- assign active_selector_style = meta_selector_style | default: 'block' -%}
  {%- assign active_option_name = meta_option_name | default: 'Color' -%}
  
  <div class="linked-products-picker" style="
    --lp-swatch-size: {{ app_settings.swatchSize | default: 50 }}px;
    --lp-items-gap: {{ app_settings.itemsGap | default: 8 }}px;
    --lp-border-radius: {{ app_settings.borderRadius | default: 8 }}px;
    --lp-border-color: {{ app_settings.borderColor | default: '#e5e5e5' }};
    --lp-selected-border-color: {{ app_settings.selectedBorderColor | default: '#000000' }};
    --lp-border-width: {{ app_settings.borderWidth | default: 2 }}px;
    --lp-block-padding-x: {{ app_settings.blockPaddingX | default: 12 }}px;
    --lp-block-padding-y: {{ app_settings.blockPaddingY | default: 8 }}px;
    --lp-block-font-size: {{ app_settings.blockFontSize | default: 14 }}px;
    --lp-block-bg: {{ app_settings.blockBgColor | default: '#ffffff' }};
    --lp-block-text: {{ app_settings.blockTextColor | default: '#000000' }};
    --lp-selected-bg: {{ app_settings.selectedBgColor | default: '#000000' }};
    --lp-selected-text: {{ app_settings.selectedTextColor | default: '#ffffff' }};
  ">
    <div class="variant-picker">
      <fieldset class="variant-picker__option">
        {%- if app_settings.showOptionName != false and active_option_name != blank -%}
          <div class="variant-picker__option-info">
            <div class="h-stack gap-2">
              {%- assign select_label = app_settings.selectOptionLabel | default: 'Select {option}' | replace: '{option}', active_option_name -%}
              <legend class="text-subdued">{{ select_label }}:</legend>
              <span class="selected-value">{{ product.metafields.linked_products.option_value.value | default: product.title }}</span>
            </div>
          </div>
        {%- endif -%}

        {%- if active_selector_style contains 'dropdown' -%}
          <div class="variant-picker__dropdown">
            <select class="linked-products-dropdown" onchange="if(this.value) window.location.href = this.value;">
              {%- assign current_rendered_dd = false -%}
              {%- for item in linked_handles_raw -%}
                {%- assign item_handle = item.handle -%}
                {%- if item_handle == current_handle -%}
                  {%- assign current_value = product.metafields.linked_products.option_value.value | default: product.title -%}
                  <option value="{{ product.url }}" selected>{{ current_value }}</option>
                  {%- assign current_rendered_dd = true -%}
                {%- else -%}
                  {%- assign linked_prod = all_products[item_handle] -%}
                  {%- if linked_prod != blank and linked_prod != empty -%}
                    {%- if inventory_behavior == 'hide' and linked_prod.available == false -%}
                      {%- continue -%}
                    {%- endif -%}
                    {%- assign value = item.title | default: linked_prod.title -%}
                    <option value="{{ linked_prod.url }}"
                      {%- if linked_prod.available == false %} disabled{%- endif -%}
                    >{{ value }}{%- if linked_prod.available == false %} ({{ app_settings.soldOutLabel | default: 'Sold out' }}){%- endif -%}</option>
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
              {%- unless current_rendered_dd -%}
                {%- assign current_value = product.metafields.linked_products.option_value.value | default: product.title -%}
                <option value="{{ product.url }}" selected>{{ current_value }}</option>
              {%- endunless -%}
            </select>
          </div>
        {%- else -%}
          <div class="variant-picker__option-values wrap" style="gap: var(--lp-items-gap);">
            {%- assign current_rendered = false -%}
            
            {%- for item in linked_handles_raw -%}
              {%- assign item_handle = item.handle -%}
              {%- if item_handle == current_handle -%}
                {%- assign current_value = product.metafields.linked_products.option_value.value | default: product.title -%}
                {%- render 'linked-product-option', 
                    product_obj: product,
                    value: current_value, 
                    selected: true,
                    style: active_selector_style,
                    settings: app_settings,
                    custom_image: item.image,
                    custom_color: item.color
                -%}
                {%- assign current_rendered = true -%}
              {%- else -%}
                {%- assign linked_prod = all_products[item_handle] -%}
                {%- if linked_prod != blank and linked_prod != empty -%}
                  {%- if inventory_behavior == 'hide' and linked_prod.available == false -%}
                    {%- continue -%}
                  {%- endif -%}

                  {%- assign value = item.title | default: linked_prod.title -%}
                  {%- render 'linked-product-option', 
                      product_obj: linked_prod,
                      value: value, 
                      selected: false,
                      style: active_selector_style,
                      settings: app_settings,
                      custom_image: item.image,
                      custom_color: item.color
                  -%}
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
            
            {%- unless current_rendered -%}
              {%- assign current_value = product.metafields.linked_products.option_value.value | default: product.title -%}
              {%- render 'linked-product-option', 
                  product_obj: product,
                  value: current_value, 
                  selected: true,
                  style: active_selector_style,
                  settings: app_settings
              -%}
            {%- endunless -%}
          </div>
        {%- endif -%}
      </fieldset>
    </div>
  </div>

{%- endif -%}

{% schema %}
{
  "name": "Linked Products",
  "target": "section",
  "stylesheet": "linked-products.css",
  "settings": [
    {
      "type": "paragraph",
      "content": "Settings are now managed in the [App Admin](/apps/variants-linked-products/app/settings)."
    }
  ]
}
{% endschema %}
