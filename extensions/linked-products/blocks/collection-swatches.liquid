<style>
  .collection-swatches {
    margin-top: 6px;
    --cs-size: 22px;
    --cs-gap: 4px;
    --cs-border-radius: 50%;
    --cs-border-color: #e5e5e5;
    --cs-selected-border-color: #000;
  }
  
  .collection-swatches__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--cs-gap);
    align-items: center;
  }
  
  .cs-swatch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--cs-size);
    height: var(--cs-size);
    border-radius: var(--cs-border-radius);
    border: 1.5px solid var(--cs-border-color);
    overflow: hidden;
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease;
    cursor: pointer;
    flex-shrink: 0;
  }
  
  .cs-swatch:hover {
    border-color: var(--cs-selected-border-color);
    transform: scale(1.15);
  }
  
  .cs-swatch--active {
    border-color: var(--cs-selected-border-color);
    border-width: 2px;
  }
  
  .cs-swatch--unavailable {
    opacity: 0.4;
  }
  
  .cs-swatch__color {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    border: 1px solid rgba(0, 0, 0, 0.08);
  }
  
  .cs-swatch__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: inherit;
  }
  
  .cs-swatch__text {
    font-size: 10px;
    font-weight: 600;
    color: #666;
    text-transform: uppercase;
  }
  
  .cs-swatch--more {
    font-size: 10px;
    font-weight: 600;
    color: #666;
    background: #f5f5f5;
    border-color: transparent;
    pointer-events: none;
  }
</style>

{% schema %}
{
  "name": "Collection Swatches",
  "target": "section",
  "stylesheet": "linked-products.css",
  "settings": [
    {
      "type": "header",
      "content": "Swatch Appearance"
    },
    {
      "type": "select",
      "id": "swatch_style",
      "label": "Default Swatch Style",
      "options": [
        { "value": "swatch", "label": "Color Swatch" },
        { "value": "variant_image", "label": "Product Image" },
        { "value": "block", "label": "Text" }
      ],
      "default": "swatch",
      "info": "Fallback style when no metafield setting exists"
    },
    {
      "type": "range",
      "id": "swatch_size",
      "label": "Swatch size",
      "min": 16,
      "max": 36,
      "step": 2,
      "default": 22,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between swatches",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "default": 50,
      "unit": "%",
      "info": "50% = circle, 0 = square"
    },
    {
      "type": "range",
      "id": "max_visible",
      "label": "Max visible swatches",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 5,
      "info": "Show '+N' indicator for remaining"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#e5e5e5"
    },
    {
      "type": "color",
      "id": "selected_border_color",
      "label": "Active border color",
      "default": "#000000"
    }
  ]
}
{% endschema %}
