{%- comment -%}
  Collection Swatches - Show linked product swatches on collection pages
  This block renders mini swatches below each product card in collection view.
  It is now synchronized with the App Admin settings.
{%- endcomment -%}

{%- assign linked_handles_raw = product.metafields.linked_products.linked_list.value -%}
{%- assign group_status = product.metafields.linked_products.status.value | default: 'active' -%}

{%- if linked_handles_raw != blank and linked_handles_raw.size > 1 and group_status == 'active' -%}
  {%- assign current_handle = product.handle -%}
  {%- assign inventory_behavior = product.metafields.linked_products.inventory_behavior.value | default: 'show' -%}
  {%- assign app_settings = shop.metafields.linked_products.app_settings.value -%}
  {%- assign general_settings = shop.metafields.linked_products.settings.value -%}
  {%- assign style_customizations = shop.metafields.linked_products.style_customizations.value -%}

  {%- comment -%}Determine which style to use for the card{%- endcomment -%}
  {%- assign card_style = product.metafields.linked_products.card_selector_style.value | default: app_settings.defaultCardStyle | default: 'image_swatch_card' -%}
  
  {%- comment -%}Auto-migrate legacy style ID{%- endcomment -%}
  {%- if card_style == 'image_swatch_on_card' -%}
    {%- assign card_style = 'image_swatch_card' -%}
  {%- elsif card_style == 'color_swatch_on_card' -%}
    {%- assign card_style = 'color_swatch_card' -%}
  {%- elsif card_style == 'button_on_card' -%}
    {%- assign card_style = 'button_card' -%}
  {%- elsif card_style == 'dropdown_on_card' -%}
    {%- assign card_style = 'dropdown_card' -%}
  {%- endif -%}

  {%- assign active_style_settings = style_customizations[card_style] -%}

  {%- comment -%}Style-specific Defaults (Sync with DEFAULT_SETTINGS_BY_STYLE in app/utils/style-utils.jsx){%- endcomment -%}
  {%- assign def_size = 24 -%}{%- assign def_gap = 4 -%}{%- assign def_radius = 50 -%}{%- assign def_padding = 0 -%}
  {%- if card_style == 'color_swatch_card' -%}
    {%- assign def_radius = 12 -%}
  {%- endif -%}

  {%- assign lp_swatch_size = active_style_settings.basic.swatchSize | default: def_size -%}
  {%- assign lp_items_gap = active_style_settings.basic.gap | default: def_gap -%}
  {%- assign lp_padding = active_style_settings.basic.padding | default: def_padding -%}
  {%- assign lp_border_radius = active_style_settings.border.radius | default: def_radius -%}
  {%- assign lp_max_swatches = active_style_settings.basic.limitDesktop | default: 5 -%}
  {%- assign lp_two_color_style = active_style_settings.basic.twoColorStyle | default: 'LT_RB' -%}

  {%- assign lp_border_width = active_style_settings.border.width | default: 1 -%}
  {%- assign lp_border_color = active_style_settings.border.color | default: '#dbdfe2' -%}
  {%- assign lp_selected_border_color = active_style_settings.border.activeColor | default: '#000000' -%}
  {%- assign lp_hover_border_color = active_style_settings.border.hoverColor | default: lp_border_color -%}

  {%- assign lp_aspect_ratio = active_style_settings.basic.aspectRatio | replace: ':', '/' | default: '1/1' -%}
  {%- assign lp_image_position = active_style_settings.basic.imagePosition | default: 'center' -%}
  {%- assign lp_hover_effect = active_style_settings.basic.hoverEffect | default: 'none' -%}

  {{ 'linked-products.css' | asset_url | stylesheet_tag }}

  <div class="collection-swatches linked-products-picker" style="
    --lp-swatch-size: {{ lp_swatch_size }}px;
    --lp-items-gap: {{ lp_items_gap }}px;
    --lp-swatch-padding: {{ lp_padding }}px;
    --lp-border-radius: {{ lp_border_radius }}{% if card_style contains 'swatch' %}%{% else %}px{% endif %};
    --lp-border-color: {{ lp_border_color }};
    --lp-selected-border-color: {{ lp_selected_border_color }};
    --lp-hover-border-color: {{ lp_hover_border_color }};
    --lp-border-width: {{ lp_border_width }}px;
    --lp-aspect-ratio: {{ lp_aspect_ratio }};
    --lp-image-position: {{ lp_image_position }};
    --lp-hover-effect: {{ lp_hover_effect }};
    --lp-margin-top: {{ app_settings.cardMarginTop | default: 0 }}px;
    --lp-margin-bottom: {{ app_settings.cardMarginBottom | default: 6 }}px;
    --lp-justify: {% if app_settings.cardAlign == 'center' %}center{% elsif app_settings.cardAlign == 'right' %}flex-end{% else %}flex-start{% endif %};
  "
  data-hover-effect="{{ lp_hover_effect }}"
  >
    {%- if app_settings.cardShowLabel -%}
        <div class="lp-card-label" style="margin-bottom: 4px; text-align: {{ app_settings.cardAlign | default: 'left' }}; font-size: 12px; font-weight: 600; color: #333;">
            {{ active_style_settings.label.text | default: 'Options' }}:
        </div>
    {%- endif -%}
    {%- if app_settings.cardDisplayMode == 'count' -%}
        <div class="lp-count-only" style="margin-top: 4px;">
            <span style="font-size: 12px; color: #666; font-weight: 500;">
                {{ linked_handles_raw.size }} options
            </span>
        </div>
    {%- else -%}
        <div class="variant-picker__option-values wrap" style="gap: var(--lp-items-gap); margin-top: 0; justify-content: var(--lp-justify);">
            {%- assign rendered_count = 0 -%}
            {%- for item in linked_handles_raw -%}
                {%- if rendered_count >= lp_max_swatches %}{% break %}{% endif -%}
                
                {%- assign item_handle = item.handle -%}
                {%- if item_handle == current_handle -%}
                    {%- assign current_value = product.metafields.linked_products.option_value.value | default: product.title -%}
                    {%- render 'linked-product-option', 
                        product_obj: product,
                        value: current_value, 
                        selected: true,
                        style: card_style,
                        settings: active_style_settings,
                        custom_image: item.image,
                        custom_color: item.color,
                        custom_color2: item.color2,
                        item_style: item.style,
                        two_color_style: lp_two_color_style
                    -%}
                    {%- assign rendered_count = rendered_count | plus: 1 -%}
                {%- else -%}
                    {%- assign linked_prod = all_products[item_handle] -%}
                    {%- if linked_prod != blank and linked_prod != empty -%}
                        {%- if inventory_behavior == 'hide' and linked_prod.available == false %}{% continue %}{% endif -%}
                        {%- assign value = item.title | default: linked_prod.title -%}
                        {%- render 'linked-product-option', 
                            product_obj: linked_prod,
                            value: value, 
                            selected: false,
                            style: card_style,
                            settings: active_style_settings,
                            custom_image: item.image,
                            custom_color: item.color,
                            custom_color2: item.color2,
                            item_style: item.style,
                            two_color_style: lp_two_color_style
                        -%}
                        {%- assign rendered_count = rendered_count | plus: 1 -%}
                    {%- endif -%}
                {%- endif -%}
            {%- endfor -%}

            {%- assign total_items = linked_handles_raw.size -%}
            {%- if total_items > rendered_count -%}
                {%- assign remaining = total_items | minus: rendered_count -%}
                <span class="lp-more-count" style="font-size: 10px; font-weight: 600; color: #999; display: flex; align-items: center;">
                    +{{ remaining }}
                </span>
            {%- endif -%}
        </div>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Collection Swatches",
  "target": "section",
  "stylesheet": "linked-products.css",
  "settings": [
    {
      "type": "paragraph",
      "content": "Settings are now managed in the [App Admin](/apps/variants-linked-products/app/settings). This block will automatically respect the 'Product Card' style customized in the app."
    }
  ]
}
{% endschema %}
