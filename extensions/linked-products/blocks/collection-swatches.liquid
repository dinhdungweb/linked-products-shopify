{%- assign lp_app_settings = shop.metafields.linked_products.app_settings.value -%}
{%- if lp_app_settings == blank -%}
  {%- assign lp_app_settings = shop.metafields.linked_products.settings.value -%}
{%- endif -%}

{%- if lp_app_settings.customCssCollection != blank -%}
  <style id="lp-custom-collection-css-block">
    {{ lp_app_settings.customCssCollection }}
  </style>
{%- endif -%}

{%- render 'linked-product-card-swatches', product: product -%}


{% schema %}
{
  "name": "Collection Swatches",
  "target": "section",
  "stylesheet": "linked-products.css",
  "settings": [
    {
      "type": "paragraph",
      "content": "Settings are now managed in the [App Admin](/apps/variants-linked-products/app/settings). This block will automatically respect the 'Product Card' style customized in the app."
    }
  ]
}
{% endschema %}
