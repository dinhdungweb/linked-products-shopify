// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// Product Group - Nhóm các sản phẩm liên kết
model ProductGroup {
  id                String    @id @default(cuid())
  shop              String    // Shop domain
  name              String    // Tên nhóm (để dễ quản lý)
  optionName        String    @default("Color") // Tên option hiển thị (Color, Size, etc.)
  selectorStyle     String    @default("block") // swatch, variant_image, block
  cardSelectorStyle String    @default("same")  // same, swatch, pill
  syncStatus        String    @default("pending") // pending, synced, error
  inventoryBehavior String    @default("show") // hide, show
  status            String    @default("active") // active, draft
  products          ProductGroupItem[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([shop])
}

// Product Group Item - Sản phẩm trong nhóm
model ProductGroupItem {
  id             String    @id @default(cuid())
  groupId        String
  productId      String    // Shopify Product GID
  productHandle  String?   // Product handle để sử dụng trong Liquid
  optionValue    String?   // Giá trị option (Red, Blue, etc.)
  customImageUrl String?   // Hình ảnh tùy chỉnh cho swatch
  customColor    String?   // Màu sắc tùy chỉnh (HEX)
  customColor2   String?   // Màu sắc tùy chỉnh thứ 2 (HEX), dùng khi style là 'two'
  style          String?   @default("one") // one, two
  position       Int       @default(0)
  group          ProductGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())

  @@unique([groupId, productId])
  @@index([groupId])
}

// Automation Rule - Quy tắc tự động gom nhóm sản phẩm
model AutomationRule {
  id              String    @id @default(cuid())
  shop            String    // Shop domain
  name            String    // Tên rule để dễ quản lý
  type            String    // title_pattern, tag, sku_pattern, collection
  pattern         String    // Pattern hoặc giá trị để match (regex cho title/sku, tag name, collection id)
  optionName      String    @default("Color") // Tên option cho nhóm được tạo
  selectorStyle   String    @default("block") // swatch, variant_image, block, dropdown
  status          String    @default("active") // active, paused
  groupsCreated   Int       @default(0)  // Số nhóm đã tạo
  lastRunAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([shop])
  @@index([shop, type])
}

// Shop - Track subscription plan
model Shop {
  id            String    @id @default(cuid())
  shop          String    @unique
  plan          String    @default("free") // free, basic, pro
  chargeId      String?   // Shopify subscription charge ID
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Shop settings - Cấu hình hiển thị global
model AppSetting {
  id                    String    @id @default(cuid())
  shop                  String    @unique
  appEnabled            Boolean   @default(true)
  showOnProductCards    Boolean   @default(true)
  applyToCollection     Boolean   @default(true)
  applyToSearch         Boolean   @default(true)
  applyToHome           Boolean   @default(false)
  hideMultiOptionOnCards Boolean  @default(true)
  hideInaccessible      Boolean   @default(true)
  removeArchived        Boolean   @default(false)
  seamlessSwitching     Boolean   @default(false)
  autoScroll            Boolean   @default(false)
  enableAutosuggestion  Boolean   @default(true)
  notificationEmail     String?
  selectOptionLabel     String    @default("Select {option}")
  soldOutLabel          String    @default("Sold out")
  unavailableLabel      String    @default("Unavailable")
  swatchSize            Int       @default(50)
  itemsGap              Int       @default(8)
  borderRadius          Int       @default(8)
  borderWidth           Int       @default(1)
  borderColor           String    @default("#e5e5e5")
  selectedBorderColor   String    @default("#000000")
  showOptionName        Boolean   @default(true)
  blockPaddingX         Int       @default(12)
  blockPaddingY         Int       @default(8)
  blockFontSize         Int       @default(14)
  blockBgColor          String    @default("#ffffff")
  blockTextColor        String    @default("#000000")
  selectedBgColor       String    @default("#dddddd")
  selectedTextColor     String    @default("#000000")
  customCssProduct      String    @default("")
  customCssCollection   String    @default("")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}
// Option Style Settings - Cấu hình hiển thị theo từng loại style
model OptionStyleSetting {
  id             String    @id @default(cuid())
  shop           String
  styleId        String    // e.g. 'image_swatch', 'color_swatch'
  settings       Json      // Lưu trữ cấu hình dưới dạng JSON
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([shop, styleId])
  @@index([shop])
}
